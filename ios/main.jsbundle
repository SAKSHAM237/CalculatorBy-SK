__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.concatDocs=void 0;e.concatDocs={name:'concat',category:'Matrix',syntax:['concat(A, B, C, ...)','concat(A, B, C, ..., dim)'],description:'Concatenate matrices. By default, the matrices are concatenated by the last dimension. The dimension on which to concatenate can be provided as last argument.',examples:['A = [1, 2; 5, 6]','B = [3, 4; 7, 8]','concat(A, B)','concat(A, B, 1)','concat(A, B, 2)'],seealso:['det','diag','identity','inv','ones','range','size','squeeze','subset','trace','transpose','zeros']}},797,[]);

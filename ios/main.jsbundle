__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.absDocs=void 0;e.absDocs={name:'abs',category:'Arithmetic',syntax:['abs(x)'],description:'Compute the absolute value.',examples:['abs(3.5)','abs(-4.2)'],seealso:['sign']}},734,[]);

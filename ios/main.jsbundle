__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.multinomialDocs=void 0;e.multinomialDocs={name:'multinomial',category:'Probability',syntax:['multinomial(A)'],description:'Multinomial Coefficients compute the number of ways of picking a1, a2, ..., ai unordered outcomes from `n` possibilities. multinomial takes one array of integers as an argument. The following condition must be enforced: every ai > 0.',examples:['multinomial([1, 2, 1])'],seealso:['combinations','factorial']}},846,[]);

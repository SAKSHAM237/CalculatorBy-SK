__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.log1pDocs=void 0;e.log1pDocs={name:'log1p',category:'Arithmetic',syntax:['log1p(x)','log1p(x, base)'],description:'Calculate the logarithm of a `value+1`',examples:['log1p(2.5)','exp(log1p(1.4))','pow(10, 4)','log1p(9999, 10)','log1p(9999) / log(10)'],seealso:['exp','log','log2','log10']}},753,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.log10Docs=void 0;e.log10Docs={name:'log10',category:'Arithmetic',syntax:['log10(x)'],description:'Compute the 10-base logarithm of a value.',examples:['log10(0.00001)','log10(10000)','10 ^ 4','log(10000) / log(10)','log(10000, 10)'],seealso:['exp','log']}},754,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.modDocs=void 0;e.modDocs={name:'mod',category:'Operators',syntax:['x % y','x mod y','mod(x, y)'],description:'Calculates the modulus, the remainder of an integer division.',examples:['7 % 3','11 % 2','10 mod 4','isOdd(x) = x % 2','isOdd(2)','isOdd(3)'],seealso:['divide']}},755,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.multiplyDocs=void 0;e.multiplyDocs={name:'multiply',category:'Operators',syntax:['x * y','multiply(x, y)'],description:'multiply two values.',examples:['a = 2.1 * 3.4','a / 3.4','2 * 3 + 4','2 * (3 + 4)','3 * 2.1 km'],seealso:['divide']}},756,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.normDocs=void 0;e.normDocs={name:'norm',category:'Arithmetic',syntax:['norm(x)','norm(x, p)'],description:'Calculate the norm of a number, vector or matrix.',examples:['abs(-3.5)','norm(-3.5)','norm(3 - 4i)','norm([1, 2, -3], Infinity)','norm([1, 2, -3], -Infinity)','norm([3, 4], 2)','norm([[1, 2], [3, 4]], 1)','norm([[1, 2], [3, 4]], "inf")','norm([[1, 2], [3, 4]], "fro")']}},757,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.nthRootDocs=void 0;e.nthRootDocs={name:'nthRoot',category:'Arithmetic',syntax:['nthRoot(a)','nthRoot(a, root)'],description:"Calculate the nth root of a value. The principal nth root of a positive real number A, is the positive real solution of the equation \"x^root = A\".",examples:['4 ^ 3','nthRoot(64, 3)','nthRoot(9, 2)','sqrt(9)'],seealso:['nthRoots','pow','sqrt']}},758,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.nthRootsDocs=void 0;e.nthRootsDocs={name:'nthRoots',category:'Arithmetic',syntax:['nthRoots(A)','nthRoots(A, root)'],description:"Calculate the nth roots of a value. An nth root of a positive real number A, is a positive real solution of the equation \"x^root = A\". This function returns an array of complex values.",examples:['nthRoots(1)','nthRoots(1, 3)'],seealso:['sqrt','pow','nthRoot']}},759,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.powDocs=void 0;e.powDocs={name:'pow',category:'Operators',syntax:['x ^ y','pow(x, y)'],description:'Calculates the power of x to y, x^y.',examples:['2^3','2*2*2','1 + e ^ (pi * i)','pow([[1, 2], [4, 3]], 2)','pow([[1, 2], [4, 3]], -1)'],seealso:['multiply','nthRoot','nthRoots','sqrt']}},760,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.roundDocs=void 0;e.roundDocs={name:'round',category:'Arithmetic',syntax:['round(x)','round(x, n)','round(unit, valuelessUnit)','round(unit, n, valuelessUnit)'],description:'round a value towards the nearest integer.If x is complex, both real and imaginary part are rounded towards the nearest integer. When n is specified, the value is rounded to n decimals.',examples:['round(3.2)','round(3.8)','round(-4.2)','round(-4.8)','round(pi, 3)','round(123.45678, 2)','round(3.241cm, 2, cm)','round([3.2, 3.8, -4.7])'],seealso:['ceil','floor','fix']}},761,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.signDocs=void 0;e.signDocs={name:'sign',category:'Arithmetic',syntax:['sign(x)'],description:'Compute the sign of a value. The sign of a value x is 1 when x>1, -1 when x<0, and 0 when x=0.',examples:['sign(3.5)','sign(-4.2)','sign(0)'],seealso:['abs']}},762,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.sqrtDocs=void 0;e.sqrtDocs={name:'sqrt',category:'Arithmetic',syntax:['sqrt(x)'],description:'Compute the square root value. If x = y * y, then y is the square root of x.',examples:['sqrt(25)','5 * 5','sqrt(-1)'],seealso:['square','sqrtm','multiply','nthRoot','nthRoots','pow']}},763,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.sqrtmDocs=void 0;e.sqrtmDocs={name:'sqrtm',category:'Arithmetic',syntax:['sqrtm(x)'],description:'Calculate the principal square root of a square matrix. The principal square root matrix `X` of another matrix `A` is such that `X * X = A`.',examples:['sqrtm([[33, 24], [48, 57]])'],seealso:['sqrt','abs','square','multiply']}},764,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.squareDocs=void 0;e.squareDocs={name:'square',category:'Arithmetic',syntax:['square(x)'],description:'Compute the square of a value. The square of x is x * x.',examples:['square(3)','sqrt(9)','3^2','3 * 3'],seealso:['multiply','pow','sqrt','cube']}},765,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.subtractDocs=void 0;e.subtractDocs={name:'subtract',category:'Operators',syntax:['x - y','subtract(x, y)'],description:'subtract two values.',examples:['a = 5.3 - 2','a + 2','2/3 - 1/6','2 * 3 - 3','2.1 km - 500m'],seealso:['add']}},766,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.unaryMinusDocs=void 0;e.unaryMinusDocs={name:'unaryMinus',category:'Operators',syntax:['-x','unaryMinus(x)'],description:'Inverse the sign of a value. Converts booleans and strings to numbers.',examples:['-4.5','-(-5.6)','-"22"'],seealso:['add','subtract','unaryPlus']}},767,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.unaryPlusDocs=void 0;e.unaryPlusDocs={name:'unaryPlus',category:'Operators',syntax:['+x','unaryPlus(x)'],description:'Converts booleans and strings to numbers.',examples:['+true','+"2"'],seealso:['add','subtract','unaryMinus']}},768,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.xgcdDocs=void 0;e.xgcdDocs={name:'xgcd',category:'Arithmetic',syntax:['xgcd(a, b)'],description:'Calculate the extended greatest common divisor for two values. The result is an array [d, x, y] with 3 entries, where d is the greatest common divisor, and d = x * a + y * b.',examples:['xgcd(8, 12)','gcd(8, 12)','xgcd(36163, 21199)'],seealso:['gcd','lcm']}},769,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.invmodDocs=void 0;e.invmodDocs={name:'invmod',category:'Arithmetic',syntax:['invmod(a, b)'],description:'Calculate the (modular) multiplicative inverse of a modulo b. Solution to the equation ax \u2263 1 (mod b)',examples:['invmod(8, 12)','invmod(7, 13)','invmod(15151, 15122)'],seealso:['gcd','xgcd']}},770,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.bitAndDocs=void 0;e.bitAndDocs={name:'bitAnd',category:'Bitwise',syntax:['x & y','bitAnd(x, y)'],description:'Bitwise AND operation. Performs the logical AND operation on each pair of the corresponding bits of the two given values by multiplying them. If both bits in the compared position are 1, the bit in the resulting binary representation is 1, otherwise, the result is 0',examples:['5 & 3','bitAnd(53, 131)','[1, 12, 31] & 42'],seealso:['bitNot','bitOr','bitXor','leftShift','rightArithShift','rightLogShift']}},771,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.bitNotDocs=void 0;e.bitNotDocs={name:'bitNot',category:'Bitwise',syntax:['~x','bitNot(x)'],description:'Bitwise NOT operation. Performs a logical negation on each bit of the given value. Bits that are 0 become 1, and those that are 1 become 0.',examples:['~1','~2','bitNot([2, -3, 4])'],seealso:['bitAnd','bitOr','bitXor','leftShift','rightArithShift','rightLogShift']}},772,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.bitOrDocs=void 0;e.bitOrDocs={name:'bitOr',category:'Bitwise',syntax:['x | y','bitOr(x, y)'],description:'Bitwise OR operation. Performs the logical inclusive OR operation on each pair of corresponding bits of the two given values. The result in each position is 1 if the first bit is 1 or the second bit is 1 or both bits are 1, otherwise, the result is 0.',examples:['5 | 3','bitOr([1, 2, 3], 4)'],seealso:['bitAnd','bitNot','bitXor','leftShift','rightArithShift','rightLogShift']}},773,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.bitXorDocs=void 0;e.bitXorDocs={name:'bitXor',category:'Bitwise',syntax:['bitXor(x, y)'],description:'Bitwise XOR operation, exclusive OR. Performs the logical exclusive OR operation on each pair of corresponding bits of the two given values. The result in each position is 1 if only the first bit is 1 or only the second bit is 1, but will be 0 if both are 0 or both are 1.',examples:['bitOr(1, 2)','bitXor([2, 3, 4], 4)'],seealso:['bitAnd','bitNot','bitOr','leftShift','rightArithShift','rightLogShift']}},774,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.leftShiftDocs=void 0;e.leftShiftDocs={name:'leftShift',category:'Bitwise',syntax:['x << y','leftShift(x, y)'],description:'Bitwise left logical shift of a value x by y number of bits.',examples:['4 << 1','8 >> 1'],seealso:['bitAnd','bitNot','bitOr','bitXor','rightArithShift','rightLogShift']}},775,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.rightArithShiftDocs=void 0;e.rightArithShiftDocs={name:'rightArithShift',category:'Bitwise',syntax:['x >> y','rightArithShift(x, y)'],description:'Bitwise right arithmetic shift of a value x by y number of bits.',examples:['8 >> 1','4 << 1','-12 >> 2'],seealso:['bitAnd','bitNot','bitOr','bitXor','leftShift','rightLogShift']}},776,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.rightLogShiftDocs=void 0;e.rightLogShiftDocs={name:'rightLogShift',category:'Bitwise',syntax:['x >>> y','rightLogShift(x, y)'],description:'Bitwise right logical shift of a value x by y number of bits.',examples:['8 >>> 1','4 << 1','-12 >>> 2'],seealso:['bitAnd','bitNot','bitOr','bitXor','leftShift','rightArithShift']}},777,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.bellNumbersDocs=void 0;e.bellNumbersDocs={name:'bellNumbers',category:'Combinatorics',syntax:['bellNumbers(n)'],description:'The Bell Numbers count the number of partitions of a set. A partition is a pairwise disjoint subset of S whose union is S. `bellNumbers` only takes integer arguments. The following condition must be enforced: n >= 0.',examples:['bellNumbers(3)','bellNumbers(8)'],seealso:['stirlingS2']}},778,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.catalanDocs=void 0;e.catalanDocs={name:'catalan',category:'Combinatorics',syntax:['catalan(n)'],description:'The Catalan Numbers enumerate combinatorial structures of many different types. catalan only takes integer arguments. The following condition must be enforced: n >= 0.',examples:['catalan(3)','catalan(8)'],seealso:['bellNumbers']}},779,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.compositionDocs=void 0;e.compositionDocs={name:'composition',category:'Combinatorics',syntax:['composition(n, k)'],description:'The composition counts of n into k parts. composition only takes integer arguments. The following condition must be enforced: k <= n.',examples:['composition(5, 3)'],seealso:['combinations']}},780,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.stirlingS2Docs=void 0;e.stirlingS2Docs={name:'stirlingS2',category:'Combinatorics',syntax:['stirlingS2(n, k)'],description:'he Stirling numbers of the second kind, counts the number of ways to partition a set of n labelled objects into k nonempty unlabelled subsets. `stirlingS2` only takes integer arguments. The following condition must be enforced: k <= n. If n = k or k = 1, then s(n,k) = 1.',examples:['stirlingS2(5, 3)'],seealso:['bellNumbers']}},781,[]);

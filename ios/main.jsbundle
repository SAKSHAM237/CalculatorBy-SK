__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.setCartesianDocs=void 0;e.setCartesianDocs={name:'setCartesian',category:'Set',syntax:['setCartesian(set1, set2)'],description:'Create the cartesian product of two (multi)sets. Multi-dimension arrays will be converted to single-dimension arrays and the values will be sorted in ascending order before the operation.',examples:['setCartesian([1, 2], [3, 4])'],seealso:['setUnion','setIntersect','setDifference','setPowerset']}},862,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.setDifferenceDocs=void 0;e.setDifferenceDocs={name:'setDifference',category:'Set',syntax:['setDifference(set1, set2)'],description:'Create the difference of two (multi)sets: every element of set1, that is not the element of set2. Multi-dimension arrays will be converted to single-dimension arrays before the operation.',examples:['setDifference([1, 2, 3, 4], [3, 4, 5, 6])','setDifference([[1, 2], [3, 4]], [[3, 4], [5, 6]])'],seealso:['setUnion','setIntersect','setSymDifference']}},863,[]);

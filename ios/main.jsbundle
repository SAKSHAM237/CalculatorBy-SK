__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.cubeDocs=void 0;e.cubeDocs={name:'cube',category:'Arithmetic',syntax:['cube(x)'],description:'Compute the cube of a value. The cube of x is x * x * x.',examples:['cube(2)','2^3','2 * 2 * 2'],seealso:['multiply','square','pow']}},738,[]);

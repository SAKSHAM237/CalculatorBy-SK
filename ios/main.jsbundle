__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.transposeDocs=void 0;e.transposeDocs={name:'transpose',category:'Matrix',syntax:['x\'','transpose(x)'],description:'Transpose a matrix',examples:['a = [1, 2, 3; 4, 5, 6]','a\'','transpose(a)'],seealso:['concat','det','diag','identity','inv','ones','range','size','squeeze','subset','trace','zeros']}},832,[]);
